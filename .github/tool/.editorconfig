# Shared ktlint / Spotless formatting contract for Android + Compose projects.
# Consumed by gradle/spotless.init.gradle via KTLINT_EDITORCONFIG.
# Callers may drop their own .editorconfig at the repo root to override.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 140

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_filename = enabled
# @Composable functions are PascalCase by convention; ktlint's function-naming
# rule cannot see annotations reliably in all setups, so it is disabled here and
# Detekt's FunctionNaming (with ignoreAnnotated) enforces naming instead.
ktlint_standard_function-naming = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.xml]
indent_size = 4
